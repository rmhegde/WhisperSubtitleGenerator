    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhisperSubtitleGenerator.Core\WhisperSubtitleGenerator.Core.csproj" />
  </ItemGroup>

</Project>
