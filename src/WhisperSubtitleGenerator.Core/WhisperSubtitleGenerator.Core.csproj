<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0, not net8.0-windows: the core has no UI dependency, so it stays usable from a
         future CLI or a Linux build even though the WinForms app on top is Windows-only. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>WhisperSubtitleGenerator.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- Runtime carries the native whisper.cpp binaries. Without it Whisper.net compiles but
         throws at load time with a missing-native-library error. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- AllOutputsExist is the skip-existing rule and deserves tests, but it is an implementation
         detail rather than API. Exposed to the test assembly instead of made public. -->
    <InternalsVisibleTo Include="WhisperSubtitleGenerator.Tests" />
  </ItemGroup>

</Project>
